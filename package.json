{
  "name": "foodchain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Food Chain - a squishy 3D mobile tower-defense where your defenders become the threat.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
